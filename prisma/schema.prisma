generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  name               String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  projectsAsCoLeader Project[]              @relation("ProjectCoLeader")
  projectsAsLeader   Project[]              @relation("ProjectLeader")
  statusRecords      ProjectStatusRecord[]
  notifications      NotificationStatus[]
  roleCompletions    ProjectRoleCompletion[]
}

model Project {
  id                     String                @id
  receiptNumber          String?               @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  status                 ProjectStatus         @default(DRAFT)
  projectNameThai        String
  projectNameEng         String?
  leaderId               String
  leaderPosition         String
  department             String
  coLeaderId             String?
  startDate              DateTime
  endDate                DateTime
  background             String?
  projectDetails         String?
  objectives             String?
  scope                  String?
  implementationPlan     String?
  serviceType            String?
  participantCount       Int?
  venue                  String?
  committee              String?
  expectedBenefits       String?
  projectEvaluation      String?
  budgetSourceExtGov     Decimal?              @db.Decimal(15, 2)
  budgetSourceExtPrivate Decimal?              @db.Decimal(15, 2)
  budgetSourceExtForeign Decimal?              @db.Decimal(15, 2)
  budgetSourceInternal   Decimal?              @db.Decimal(15, 2)
  expenseRemuneration    Decimal?              @db.Decimal(15, 2)
  expenseSupplies        Decimal?              @db.Decimal(15, 2)
  expenseMaterials       Decimal?              @db.Decimal(15, 2)
  expenseUtilities       Decimal?              @db.Decimal(15, 2)
  expenseSubsidy         Decimal?              @db.Decimal(15, 2)
  expenseReserve         Decimal?              @db.Decimal(15, 2)
  note2                  Boolean               @default(false)
  note3                  Boolean               @default(false)
  participantDetails     String?
  // Overview-specific fields
  projectCode            String?               @unique
  memoTitle              String?
  vendorCode             String?
  costCenter             String?
  fundOwner              String?
  maintenanceFeeProposal Decimal?              @db.Decimal(15, 2)
  maintenanceFeeActual   Decimal?              @db.Decimal(15, 2)
  electricityFeeProposal Decimal?              @db.Decimal(15, 2)
  electricityFeeActual   Decimal?              @db.Decimal(15, 2)
  // Status tracking
  status1                String?
  status1Date            DateTime?
  status2                String?
  status2Date            DateTime?
  status3                String?
  status3Date            DateTime?
  status4                String?
  status4Date            DateTime?
  status5                String?
  status5Date            DateTime?
  responsible            String?
  docNumber              String?
  docDate                DateTime?
  docLink                String?
  // New status system
  currentStatusCode      String?                    @default("DRAFT")
  currentStatusId        String?                    @unique
  currentStatus          ProjectStatusRecord?       @relation("CurrentStatus", fields: [currentStatusId], references: [id])
  statusHistory          ProjectStatusRecord[]      @relation("StatusHistory")
  draftState             DraftState                 @default(SUBMITTED)
  draftSavedAt           DateTime?
  submittedAt            DateTime?
  submittedByRole        String?
  roleCompletions        ProjectRoleCompletion[]
  approvalEmailLogs      ApprovalEmailLog[]
  incomeItems            IncomeItem[]
  coLeader               User?                 @relation("ProjectCoLeader", fields: [coLeaderId], references: [id])
  leader                 User                  @relation("ProjectLeader", fields: [leaderId], references: [id])
  collaborators          ProjectCollaborator[]
  managers               ProjectManager[]
  strategies             ProjectStrategy[]
  targetGroups           ProjectTargetGroup[]
  meetings               Meeting[]
}

model ProjectRoleCompletion {
  id           String            @id @default(cuid())
  projectId    String
  role         ClosureRole
  isComplete   Boolean           @default(false)
  completedAt  DateTime?
  completedBy  String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  completer    User?             @relation(fields: [completedBy], references: [id])

  @@unique([projectId, role])
  @@index([projectId, isComplete])
}

model ApprovalEmailLog {
  id           String              @id @default(cuid())
  projectId     String
  recipient     String
  recipientRole String
  subject       String
  status        EmailDeliveryStatus @default(PENDING)
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([status])
}

model TargetGroup {
  id       String               @id @default(cuid())
  name     String               @unique
  projects ProjectTargetGroup[]
}

model ProjectTargetGroup {
  projectId     String
  targetGroupId String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetGroup   TargetGroup @relation(fields: [targetGroupId], references: [id])

  @@id([projectId, targetGroupId])
}

model Strategy {
  id       String            @id @default(cuid())
  name     String            @unique
  projects ProjectStrategy[]
}

model ProjectStrategy {
  projectId  String
  strategyId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  strategy   Strategy @relation(fields: [strategyId], references: [id])

  @@id([projectId, strategyId])
}

model IncomeItem {
  id           String     @id @default(cuid())
  projectId    String
  type         IncomeType
  name         String
  amount       Decimal    @db.Decimal(15, 2)
  categoryName String?
  createdAt    DateTime   @default(now())
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectManager {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum ProjectStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum IncomeType {
  SUPPORT
  REGISTRATION
  OTHER
}

model Meeting {
  id        String      @id @default(cuid())
  projectId String
  type      MeetingType
  no        String
  date      DateTime
  purpose   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum MeetingType {
  BOARD
  DEAN
}

// ============================================
// STATUS SYSTEM MODELS
// ============================================

model ProjectStatusRecord {
  id               String                 @id @default(cuid())
  projectId        String
  statusCode       StatusCode
  statusLabel      String
  subStatus        String?                // For notification sub-types
  enteredAt        DateTime               @default(now())
  enteredBy        String
  exitedAt         DateTime?
  notes            String?
  branchChoice     String?                // For STATUS_3 branching
  
  project          Project                @relation("StatusHistory", fields: [projectId], references: [id], onDelete: Cascade)
  currentFor       Project?               @relation("CurrentStatus")
  enteredByUser    User                   @relation(fields: [enteredBy], references: [id])
  notifications    NotificationStatus[]
  
  @@index([projectId, enteredAt])
  @@index([statusCode])
}

model NotificationStatus {
  id                String              @id @default(cuid())
  statusId          String
  notificationType  NotificationType
  isRequired        Boolean             @default(false)
  isCompleted       Boolean             @default(false)
  completedAt       DateTime?
  completedBy       String?
  recipient         String?
  notes             String?
  
  status            ProjectStatusRecord @relation(fields: [statusId], references: [id], onDelete: Cascade)
  completer         User?               @relation(fields: [completedBy], references: [id])
  
  @@unique([statusId, notificationType])
  @@index([statusId, isCompleted])
}

model StatusTransition {
  id            String     @id @default(cuid())
  fromStatus    StatusCode
  toStatus      StatusCode
  label         String?
  condition     String?
  order         Int        @default(0)
  
  @@unique([fromStatus, toStatus])
  @@index([fromStatus])
}

enum StatusCode {
  DRAFT
  STATUS_0
  STATUS_1
  STATUS_2
  STATUS_3
  STATUS_4
  STATUS_5
  STATUS_6
  STATUS_7
  STATUS_8
  STATUS_9
  STATUS_10
  STATUS_11
  STATUS_12
  STATUS_13
  STATUS_14
  STATUS_15
  RECALL
}

enum DraftState {
  DRAFT
  SUBMITTED
}

enum ClosureRole {
  RESEARCH
  PHYSICAL
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationType {
  DEPT_HEAD
  FINANCE
  PLANNING
  PHYSICAL
}