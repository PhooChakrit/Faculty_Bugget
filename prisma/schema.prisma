generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projectsAsLeader   Project[] @relation("ProjectLeader")
  projectsAsCoLeader Project[] @relation("ProjectCoLeader")
}

model Project {
  id            String        @id @default(cuid())
  receiptNumber String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  status        ProjectStatus @default(DRAFT)

  // Basic Info
  projectNameThai String
  projectNameEng  String?

  // Leader Info
  leaderId       String
  leader         User   @relation("ProjectLeader", fields: [leaderId], references: [id])
  leaderPosition String
  department     String

  // Co-Leader Info
  coLeaderId String?
  coLeader   User?   @relation("ProjectCoLeader", fields: [coLeaderId], references: [id])

  // Dates
  startDate DateTime
  endDate   DateTime

  // Project Details
  background         String? @db.Text
  projectDetails     String? @db.Text
  objectives         String? @db.Text
  scope              String? @db.Text
  implementationPlan String? @db.Text
  serviceType        String?
  participantCount   Int?
  participantDetails String?
  venue              String?
  committee          String?
  expectedBenefits   String? @db.Text
  projectEvaluation  String? @db.Text

  // Budget Sources
  budgetSourceExtGov     Decimal? @db.Decimal(15, 2)
  budgetSourceExtPrivate Decimal? @db.Decimal(15, 2)
  budgetSourceExtForeign Decimal? @db.Decimal(15, 2)
  budgetSourceInternal   Decimal? @db.Decimal(15, 2)

  // Expenses
  expenseRemuneration Decimal? @db.Decimal(15, 2)
  expenseSupplies     Decimal? @db.Decimal(15, 2)
  expenseMaterials    Decimal? @db.Decimal(15, 2)
  expenseUtilities    Decimal? @db.Decimal(15, 2)
  expenseSubsidy      Decimal? @db.Decimal(15, 2)
  expenseReserve      Decimal? @db.Decimal(15, 2)

  // Notes
  note2 Boolean @default(false)
  note3 Boolean @default(false)

  // Relations
  targetGroups  ProjectTargetGroup[]
  strategies    ProjectStrategy[]
  incomeItems   IncomeItem[]
  collaborators ProjectCollaborator[]
  managers      ProjectManager[]
}

enum ProjectStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Many-to-Many: Project <-> TargetGroup
model TargetGroup {
  id       String               @id @default(cuid())
  name     String               @unique
  projects ProjectTargetGroup[]
}

model ProjectTargetGroup {
  projectId     String
  targetGroupId String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetGroup   TargetGroup @relation(fields: [targetGroupId], references: [id])

  @@id([projectId, targetGroupId])
}

// Many-to-Many: Project <-> Strategy
model Strategy {
  id       String            @id @default(cuid())
  name     String            @unique
  projects ProjectStrategy[]
}

model ProjectStrategy {
  projectId  String
  strategyId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  strategy   Strategy @relation(fields: [strategyId], references: [id])

  @@id([projectId, strategyId])
}

// Income Items (เงินสนับสนุน / ค่าลงทะเบียน)
model IncomeItem {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      IncomeType
  name      String
  amount    Decimal    @db.Decimal(15, 2)
  createdAt DateTime   @default(now())
}

enum IncomeType {
  SUPPORT // เงินสนับสนุน
  REGISTRATION // ค่าลงทะเบียน
}

// Project Collaborators (ผู้ร่วมโครงการ)
model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
}

// Project Managers (ผู้รับผิดชอบโครงการ)
model ProjectManager {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  createdAt DateTime @default(now())
}
